# Put comments on their own line (never after a value).

# ---------- Required ----------
# API_ID / API_HASH come from my.telegram.org
API_ID=12345
API_HASH=your_api_hash
# BOT_TOKEN comes from @BotFather
BOT_TOKEN=123456:your_bot_token
# SESSION_STRING = Pyrogram session of the assistant account that joins voice chats
SESSION_STRING=your_pyrogram_session_string
# OWNER_ID = YOUR Telegram user id (send /id to the bot to see it)
OWNER_ID=123456789

# ---------- Branding ----------
BOT_NAME=RIA Music
# Usernames without @. Leave the value empty to hide that button.
SUPPORT_GROUP=
UPDATES_CHANNEL=
# WELCOME_IMAGE: URL or file_id. Default is assets/welcome.jpg (make your own with tools/make_banner.py)
# WELCOME_IMAGE=

# ---------- Storage (docker-compose overrides DB_PATH) ----------
DB_PATH=data/nexa.db
LOG_DIR=logs

# ---------- JioSaavn (unofficial API). Several hosts can be listed, comma-separated ----------
SAAVN_API_BASE=https://saavn.sumit.co/api,https://saavn.dev/api
# SAAVN_API_STYLE is dev or legacy
SAAVN_API_STYLE=dev
SAAVN_FALLBACK=true

# ---------- Voice chat behaviour (saves the VPS) ----------
VC_CHECK_INTERVAL=10
VC_EMPTY_CHECKS=2
# Stop and leave after the voice chat stayed empty this many seconds
VC_IDLE_STOP_SECONDS=300

# ---------- Look ----------
# Coloured inline buttons (green/blue/red)
BUTTON_STYLES=true

# ---------- Optional ----------
# LOG_CHAT_ID=
# ENABLE_VPLAY=true
# VIDEO_MAX_HEIGHT=480
# MAX_QUEUE=50
# AUTO_JOIN_ASSISTANT=true
# PROXY_CHECK_INTERVAL=300
# PROXY_MAX_FAILS=2
# LYRICS_API_BASE=https://lrclib.net/api
