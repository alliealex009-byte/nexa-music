# --- Required
API_ID=12345
API_HASH=your_api_hash
BOT_TOKEN=123456:your_bot_token
SESSION_STRING=your_pyrogram_session_string   # assistant account that joins voice chats
OWNER_ID=123456789

# --- Branding
BOT_NAME=AccStore Music Bot
SUPPORT_GROUP=AccStore_official_chat
UPDATES_CHANNEL=accstore_official
WELCOME_IMAGE=

# --- Storage (docker-compose overrides DB_PATH to /app/data/nexa.db)
DB_PATH=data/nexa.db
LOG_DIR=logs

# --- JioSaavn unofficial API (use your own deployment for reliability)
SAAVN_API_BASE=https://saavn.dev/api
SAAVN_API_STYLE=dev        # dev | legacy
SAAVN_FALLBACK=true

# --- Voice chat behaviour (saves the VPS)
VC_CHECK_INTERVAL=10
VC_EMPTY_CHECKS=2
VC_IDLE_STOP_SECONDS=300   # stop + leave after the voice chat stayed empty this long

# --- Optional
# LOG_CHAT_ID=              # where /logger sends logs (default: owner DM)
# ENABLE_VPLAY=true
# VIDEO_MAX_HEIGHT=480
# MAX_QUEUE=50
# AUTO_JOIN_ASSISTANT=true
# PROXY_CHECK_INTERVAL=300
# PROXY_MAX_FAILS=2
# LYRICS_API_BASE=https://lrclib.net/api
# BOT_API_BASE=https://api.telegram.org
BUTTON_STYLES=true         # coloured inline buttons (green/blue/red)
