
# --- v7: account safety -------------------------------------------------
# One dedicated proxy per helper account (never shared, never changed). Lines up with SESSION_STRING, then SESSION_STRINGS.
# Example: HELPER_PROXIES=socks5://user:pass@1.2.3.4:1080,socks5://user:pass@5.6.7.8:1080   ("-" = none)
HELPER_PROXIES=
HELPER_REQUIRE_PROXY=true
# Proxies are for the helper accounts only. Turn on to also route yt-dlp downloads through them.
YTDLP_USE_PROXY=false
HELPER_START_GAP=8

# --- v9
IMAGE_UPDATE_SECONDS=10   # re-draw the timer inside the player image (0 = off)

# Channel/group for /logger (bot must be admin there). Or set it from chat: /logger set -100123…
LOG_CHAT_ID=
